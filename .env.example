# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.

# Google Gemini API key (https://aistudio.google.com/). Without it the app still runs,
# but reminder drafts fall back to fixed rule-based templates.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest