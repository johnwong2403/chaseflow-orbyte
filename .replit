modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "Run"
mode = "sequential"
author = 56208678

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 src/main.py"

[deployment]
run = ["python3", "src/main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
GEMINI_MODEL = "gemini-flash-lite-latest"
GEMINI_API_KEY = "AQ.Ab8RN6LuIOxJt6k2CGCwSvaHzZzNAeur_s_VRkBrHoUAuv5oOw"

[userenv.production]
PIP_USER = "false"
